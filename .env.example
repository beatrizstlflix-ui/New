# ---------------------------------------------------------------------------
# YouTube — modo completo (OAuth): tendencia diaria, origem do trafego,
# metricas por periodo. Requer projeto no Google Cloud + refresh token.
# Se preenchido, tem prioridade sobre o modo "API key" abaixo.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Escopos necessarios: youtube.readonly + yt-analytics.readonly
YOUTUBE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# YouTube — modo simples (API key, sem OAuth): estatisticas publicas e
# vitalicias do canal e dos videos (sem filtro por periodo, sem origem do
# trafego). Usado como alternativa quando as variaveis OAuth acima estao
# vazias.
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Opcional (modo OAuth): use se a conta OAuth tiver mais de um canal.
# YOUTUBE_CHANNEL_ID acima ja cobre o modo API key.

# ---------------------------------------------------------------------------
# Google Ads (trafego pago) — opcional. Se todas preenchidas, adiciona a
# secao "Trafego pago" ao dashboard.
# ---------------------------------------------------------------------------
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Necessario quando a conta e acessada via conta gerenciadora (MCC):
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---------------------------------------------------------------------------
# Hotmart (receita/vendas) — opcional. Credencial criada em
# Hotmart Developers > Credenciais > Criar credencial > "API Hotmart".
# ---------------------------------------------------------------------------
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC_TOKEN=

# IMPORTANTE: nunca commitar valores reais aqui. Qualquer credencial colada
# em uma conversa de chat deve ser tratada como comprometida — revogue e
# gere uma nova antes de usar em producao (veja o README).
