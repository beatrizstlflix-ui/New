# Credenciais OAuth do Google Cloud (tela de consentimento OAuth do projeto
# que gerou o refresh_token do canal STLFLIX BR). Nunca commitar o .env real.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Refresh token OAuth com escopos:
#   https://www.googleapis.com/auth/youtube.readonly
#   https://www.googleapis.com/auth/yt-analytics.readonly
# IMPORTANTE: gere um token NOVO (o que foi colado em uma conversa de chat
# deve ser considerado comprometido e revogado em
# https://myaccount.google.com/permissions).
YOUTUBE_REFRESH_TOKEN=

# Opcional: se a conta tiver mais de um canal, informe o ID do canal
# STLFLIX BR (comeca com "UC..."). Se vazio, usa o canal padrao (mine=true).
YOUTUBE_CHANNEL_ID=
